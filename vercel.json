{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/admin/(.*)", "destination": "/api/admin" }
  ],
  "functions": {
    "api/tryon/finish.js": { "maxDuration": 60 },
    "api/admin.js": { "maxDuration": 30 }
  }
}
